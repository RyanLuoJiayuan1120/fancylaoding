{
  "schemaVersion": 1,
  "id": "videoloading",
  "version": "${version}",
  "name": "Video Loading",
  "description": "Early GLFW window + video/image loading screen, handed off to the game like NeoForge's early display.",
  "authors": ["RyanLuoJiayuan1120"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "preLaunch": ["com.example.videoloading.early.PreLaunchHook"],
    "client": ["com.example.videoloading.client.VideoLoadingClient"]
  },
  "mixins": ["videoloading.mixins.json"],
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "1.21.11",
    "java": ">=21"
  }
}
